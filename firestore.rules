rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validDong(dong) {
      return dong in [
        '양동', '양3동', '농성1동', '농성2동', '광천동', '유덕동',
        '치평동', '상무1동', '상무2동', '화정1동', '화정2동', '화정3동',
        '화정4동', '서창동', '금호1동', '금호2동', '풍암동', '동천동'
      ];
    }

    function validType(type) {
      return type in [
        'dark', 'cctv', 'emergencyBell', 'surveillance',
        'visibility', 'walking', 'anxiety', 'other'
      ];
    }

    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly([
          'dong', 'type', 'note', 'lat', 'lon', 'status', 'source', 'createdAt'
        ])
        && validDong(request.resource.data.dong)
        && validType(request.resource.data.type)
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 120
        && request.resource.data.lat is number
        && request.resource.data.lat >= 35.0
        && request.resource.data.lat <= 35.3
        && request.resource.data.lon is number
        && request.resource.data.lon >= 126.7
        && request.resource.data.lon <= 127.0
        && request.resource.data.status == 'received'
        && request.resource.data.source == 'citizen-web'
        && request.resource.data.createdAt == request.time;

      // 관리자 앱은 로그인 없이 운영되므로 등록 의견을 공개 조회합니다.
      allow read: if true;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'dong', 'type', 'note', 'lat', 'lon', 'status',
          'reviewerEmail', 'updatedAt', 'deleted', 'deletedAt', 'deletedBy'
        ])
        && validDong(request.resource.data.dong)
        && validType(request.resource.data.type)
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 120
        && request.resource.data.lat is number
        && request.resource.data.lat >= 35.0
        && request.resource.data.lat <= 35.3
        && request.resource.data.lon is number
        && request.resource.data.lon >= 126.7
        && request.resource.data.lon <= 127.0
        && request.resource.data.status in ['received', 'reviewing', 'reflected', 'hold']
        && request.resource.data.reviewerEmail == '관리자'
        && request.resource.data.updatedAt is timestamp
        && (!('deleted' in request.resource.data) || request.resource.data.deleted is bool);

      allow delete: if false;
    }

    match /admins/{userId} {
      allow read, write: if false;
    }

    match /mapFeatures/{featureId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == featureId
        && request.resource.data.type in ['return', 'alley', 'parcel', 'vending']
        && request.resource.data.geometry in ['line', 'point']
        && validDong(request.resource.data.dong)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 150
        && request.resource.data.points is list
        && request.resource.data.points.size() >= 1
        && request.resource.data.points.size() <= 500
        && ((request.resource.data.geometry == 'point' && request.resource.data.points.size() == 1)
          || (request.resource.data.geometry == 'line' && request.resource.data.points.size() >= 2))
        && request.resource.data.active is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == '관리자';
      allow delete: if false;
    }

    match /mapFeatureHistory/{historyId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'featureId', 'previous', 'changedTo', 'editedAt', 'editedBy'
        ])
        && request.resource.data.featureId is string
        && (request.resource.data.previous == null || request.resource.data.previous is map)
        && request.resource.data.changedTo is map
        && request.resource.data.editedAt is timestamp
        && request.resource.data.editedBy == '관리자';
      allow update, delete: if false;
    }

    // 함께가게: 접속코드를 아는 시민참여단·관리자만 명단과 결과에 접근합니다.
    function validCode(code) {
      return code.matches('^[0-9]{4,8}$');
    }

    match /hamkkeVault/{code} {
      allow get: if validCode(code);
      allow list, delete: if false;
      allow create, update: if validCode(code)
        && request.resource.data.keys().hasOnly(['active', 'updatedAt'])
        && request.resource.data.active is bool
        && request.resource.data.updatedAt is timestamp;

      match /stores/{storeId} {
        allow read: if validCode(code);
        allow delete: if false;
        allow create, update: if validCode(code)
          && request.resource.data.keys().hasOnly([
            'id', 'division', 'no', 'round', 'leader', 'name', 'owner', 'phone',
            'address', 'dong', 'category', 'active', 'updatedAt'
          ])
          && request.resource.data.id == storeId
          && request.resource.data.division in ['돌봄분과', '양성평등분과', '안전분과', '일자리분과']
          && request.resource.data.round in ['visit', 'done']
          && request.resource.data.no is number
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.owner is string && request.resource.data.owner.size() <= 40
          && request.resource.data.leader is string && request.resource.data.leader.size() <= 40
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
          && request.resource.data.address is string && request.resource.data.address.size() <= 150
          && request.resource.data.dong is string && request.resource.data.dong.size() <= 20
          && request.resource.data.category is string && request.resource.data.category.size() <= 40
          && request.resource.data.active is bool
          && request.resource.data.updatedAt is timestamp;
      }

      match /results/{storeId} {
        allow read: if validCode(code);
        allow delete: if false;
        allow create, update: if validCode(code)
          && request.resource.data.keys().hasOnly([
            'storeId', 'storeName', 'visit', 'phone', 'updatedBy', 'updatedAt'
          ])
          && request.resource.data.storeId == storeId
          && request.resource.data.storeName is string
          && request.resource.data.storeName.size() <= 80
          && (!('visit' in request.resource.data)
            || (request.resource.data.visit is map && request.resource.data.visit.keys().size() <= 30))
          && (!('phone' in request.resource.data)
            || (request.resource.data.phone is map && request.resource.data.phone.keys().size() <= 20))
          && request.resource.data.updatedBy is string
          && request.resource.data.updatedBy.size() <= 40
          && request.resource.data.updatedAt is timestamp;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
